function lineupData(){return {title:'Состав ХК «Трактор»',forwards:[1,2,3,4].map(n=>({line:n,players:SLOTS.filter(s=>s.section==='forward'&&s.line===n).map(slotData)})),defense:[1,2,3].map(n=>({pair:n,players:SLOTS.filter(s=>s.section==='defense'&&s.pair===n).map(slotData)})),goalies:SLOTS.filter(s=>s.section==='goalie').map(slotData)};}
function slotData(s){const p=playerByName.get(state[s.id].player);const r=roleByNo(state[s.id].role);const ck=p?.roleChecks?.[String(state[s.id].role)];return {position:s.name,roleNumber:r.number,role:r.name,player:p?.name||null,team:p?.teams||[],matches:p?.matches??null,roleVerdict:ck?.verdict||null,metrics:ck?.metrics||[],bestRoles:p?.bestRolesText||null,reportedSalary2026_27Mln:p?.reportedSalary2026_27Mln??null,salarySourceTeam:p?.salarySourceTeam||null,salaryMatchStatus:p?.salaryMatchStatus||null,salarySourceUrl:p?.salarySourceUrl||null};}
function showToast(msg){const el=document.getElementById('toast');el.textContent=msg;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),1900);}
function copyText(t){if(navigator.clipboard&&navigator.clipboard.writeText)return navigator.clipboard.writeText(t);const ta=document.createElement('textarea');ta.value=t;document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();return Promise.resolve();}
document.getElementById('copyLineup').addEventListener('click',()=>{const d=lineupData();const lines=[];d.forwards.forEach(l=>{lines.push(`${l.line}-е звено`);l.players.forEach(p=>lines.push(`  ${p.position}: ${p.player||'не выбран'} — ${p.role} (${p.roleVerdict||'нет оценки'})`));});d.defense.forEach(l=>{lines.push(`${l.pair}-я пара защитников`);l.players.forEach(p=>lines.push(`  ${p.position}: ${p.player||'не выбран'} — ${p.role}`));});lines.push('Вратари');d.goalies.forEach(p=>lines.push(`  ${p.position}: ${p.player||'не выбран'} — ${p.role}`));copyText(lines.join('\n')).then(()=>showToast('Состав скопирован')).catch(()=>showToast('Не удалось скопировать — попробуй вручную'));});
