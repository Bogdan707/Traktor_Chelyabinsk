  function convertToKhlEquivalent(value,key,league,age,horizon,isFuture){
    if(value==null) return null;
    const factor=isFuture ? futureLeagueFactor(league,age,horizon) : currentLeagueFactor(league);
    if(isPercentMetric(key) || key==='Saves, %'){
      const maxPenalty=key==='Saves, %'?2.4:5.0;
      const adjusted=Number(value)-(1-factor)*maxPenalty;
      return clamp(adjusted,0,100);
    }
    if(key==='Goals against' || key==='xG conceded') return Number(value);
    if(LOW_METRICS.has(key)) return Number(value)/Math.max(factor,0.45);
    return Number(value)*factor;
  }
  function ageFit(role,age){
    if(age==null || !Number.isFinite(Number(age))) return null;
    let min=null,max=null;
    const text=String(role?.ageProfile||'');
    const match=text.match(/(\d+)\s*[-–]\s*(\d+)/);
    if(match){min=Number(match[1]);max=Number(match[2]);}
    else if(/ветеран/i.test(text)){min=32;max=37;}
    else if(/пик/i.test(text)){min=26;max=30;}
    else if(/звезда/i.test(text)){min=20;max=25;}
    else if(/юниор/i.test(text)){min=18;max=20;}
    else if(/резерв/i.test(text)){min=23;max=27;}
    if(min==null) return null;
    const a=Number(age), distance=a<min?min-a:a>max?a-max:0;
    if(distance===0) return 100;
    if(distance===1) return 85;
    if(distance===2) return 72;
    if(distance===3) return 60;
    return clamp(60-(distance-3)*9,0,59);
  }
  function getRoleDataForPlayer(p){
    const id=p?.globalId || (p?.id && TRK_ROLE_STAT_DB[p.id] ? p.id : null);
    if(id && TRK_ROLE_STAT_DB[id]) return {data:TRK_ROLE_STAT_DB[id],linked:true};
    // Identity linkage is allowed only on exact full name and date of birth.
    if(p?.dob && (p?.fullName||p?.name)){
      const exact=SCOUT_DB.find(x=>norm(x.name)===norm(p.fullName||p.name) && String(x.dob||'')===String(p.dob||''));
      if(exact && TRK_ROLE_STAT_DB[exact.id]) return {data:TRK_ROLE_STAT_DB[exact.id],linked:true};
    }
    return {data:null,linked:false};
  }
  function computeFit(p,roleNo,horizon,isFuture){
    const role=roleByNo(roleNo);
    if(!role) return null;
    const g=getRoleDataForPlayer(p);
    if(!g.data){
      const check=p?.roleChecks?.[String(roleNo)];
      if(!isFuture && check && Array.isArray(check.metrics) && check.metrics.length){
        let good=0,approx=0,count=0;
        check.metrics.forEach(m=>{if(String(m).includes('✓')){good++;count++;}else if(String(m).includes('〜')||String(m).includes('~')){approx++;count++;}else if(String(m).includes('✗'))count++;});
        if(count) return {score:Math.round((good+0.5*approx)/count*100),metrics:count,total:check.metrics.length,coverage:count,confidence:check.matches<10?'Низкая выборка':`Исходная оценка · ${check.matches} матчей`,season:'внутренняя модель',league:'',games:check.matches,age:null,positionOK:effectiveKinds(p).includes(role.kind),legacy:true};
      }
      return {score:null,metrics:0,total:(role.criteria||[]).length,coverage:0,confidence:'Недостаточно сезонных метрик',season:'н/д',league:'',games:p?.matches||null,age:null,positionOK:effectiveKinds(p).includes(role.kind),legacy:true};
    }
    const st=g.data;
    const factorLeague=st.l||p?.recentLeague||'';
    const age=st.a==null?null:Number(st.a)+(isFuture?horizon:0);
    const specs=(role.criteria||[]).map(metricSpec).filter(Boolean);
    const scored=[];
    for(const spec of specs){
      let raw=isFuture?futureRawValue(st,spec.key,horizon):st.v?.[spec.key];
      if(raw==null || !Number.isFinite(Number(raw))) continue;
      const value=convertToKhlEquivalent(raw,spec.key,factorLeague,st.a,horizon,isFuture);
      let ratio;
      if(spec.higher){ratio=spec.target>0?value/spec.target:(value>=spec.target?1:0);}
      else {ratio=Number(value)<=0?1:spec.target/Number(value);}
      const score=clamp((ratio-0.70)/0.30*100,0,100);
      scored.push(score);
    }
    if(!scored.length) return {score:null,metrics:0,total:specs.length,coverage:0,confidence:'Нет сопоставимых метрик',season:st.s,league:st.l,games:st.g,age,positionOK:effectiveKinds(p).includes(role.kind),legacy:false};
    const metricScore=scored.reduce((a,b)=>a+b,0)/scored.length;
    const af=ageFit(role,age);
    const score=Math.round(af==null?metricScore:metricScore*0.85+af*0.15);
    const coverage=scored.length/(specs.length||1);
    const games=Number(st.g)||0;
    let confidence=games<10?'Низкая выборка: менее 10 матчей':games<20?'Низкая/средняя выборка':games<40?'Средняя выборка':'Достаточная выборка';
    if(st.s==='2024/25') confidence='Устаревшая база 2024/25 · проверить актуальный статус и роль';
    else if(st.s==='2025/26') confidence+=' · последний завершённый сезон';
    if(coverage<0.6) confidence+=' · мало метрик';
    const positionOK=effectiveKinds(p).includes(role.kind);
    return {score,metrics:scored.length,total:specs.length,coverage,confidence,season:st.s||'н/д',league:st.l||'',games,age,positionOK,legacy:false,trend:st.d||{}};
  }
  function metricTrendSummary(p,roleNo){
    const row=getRoleDataForPlayer(p).data;
