// Unified cross-league scouting database
let selectedScoutId = '';
function scoutPlayerKinds(p){
 const out=[];
 if((p.types||[]).includes('goalie') || (p.positions||[]).includes('G')) return ['goalie'];
 if((p.positions||[]).some(x=>['D','DEF','DEFENSE'].includes(String(x).toUpperCase()))) out.push('defense');
 if((p.positions||[]).some(x=>['F','C','LW','RW','L','R','FORWARD'].includes(String(x).toUpperCase()))) out.push('forward');
 if(!out.length && (p.types||[]).includes('skater')) return ['forward','defense'];
 return out;
}
function scoutStatSummary(p){const st=p.stats||{};const keys=['Points','Goals','Assists','Saves, %','Goals against','xG (Expected goals)','Hits','Blocked shots'];return keys.filter(k=>st[k]!==undefined).slice(0,4).map(k=>`${k}: ${st[k]}`).join(' · ');}
function salarySnippet(p){if(p.reportedSalary2026_27Mln==null)return '';return `<div class="scout-meta salary-note">Опубликованная зарплата КХЛ 2026/27: <strong>${esc(String(p.reportedSalary2026_27Mln))} млн ₽</strong> без бонусов · предварительная привязка</div>`;}
function renderScoutResults(){
 const q=(document.getElementById('scoutSearch').value||'').trim().toLocaleLowerCase('ru');
 const league=document.getElementById('scoutLeague').value;const typ=document.getElementById('scoutType').value;
 const arr=SCOUT_DB.filter(p=>(!q||(p.name+' '+(p.teams||[]).join(' ')).toLocaleLowerCase('ru').includes(q))&&(league==='all'||(p.leagues||[]).includes(league))&&(typ==='all'||(p.types||[]).includes(typ)));
 document.getElementById('scoutCount').textContent=`Найдено ${arr.length.toLocaleString('ru-RU')} профилей · показываю первые ${Math.min(30,arr.length)}`;
 const root=document.getElementById('scoutResults');
 root.innerHTML=arr.slice(0,30).map(p=>`<button type="button" class="scout-result ${selectedScoutId===p.id?'active':''}" data-scout-pick="${esc(p.id)}"><strong>${esc(p.name)}${p.dob?' · '+esc(p.dob):' · дата рождения н/д'}</strong><div class="scout-meta">${esc((p.leagues||[]).join(' / '))} · ${esc((p.teams||[]).slice(0,4).join(', ')||'команда н/д')} · ${esc((p.positions||[]).join('/'))}</div><div class="scout-meta">Сезоны: ${esc((p.seasons||[]).join(', '))}${scoutStatSummary(p)?' · '+esc(scoutStatSummary(p)):''}</div>${salarySnippet(p)}</button>`).join('')||'<div class="scout-empty">По этому запросу ничего не найдено.</div>';
 root.querySelectorAll('[data-scout-pick]').forEach(el=>el.addEventListener('click',()=>{selectedScoutId=el.dataset.scoutPick;renderScoutResults();updateScoutSelection();}));
}
function updateScoutSelection(){
 const p=SCOUT_DB.find(x=>x.id===selectedScoutId);const btn=document.getElementById('scoutInsert');const info=document.getElementById('scoutSelectedInfo');btn.disabled=!p;
 if(!p){info.textContent='Выбери игрока из результатов.';return;}
 info.textContent=`Выбран: ${p.name}${p.dob?' · '+p.dob:''} · ${p.leagues.join('/')}${p.reportedSalary2026_27Mln!=null?' · опубликованная зарплата 2026/27: '+p.reportedSalary2026_27Mln+' млн ₽ без бонусов':''}`;
 const kinds=scoutPlayerKinds(p);const sel=document.getElementById('scoutTarget');
 Array.from(sel.options).forEach(o=>{const slot=SLOTS.find(s=>s.id===o.value);o.hidden=!!slot&&!kinds.includes(slot.kind);});
 const current=SLOTS.find(s=>s.id===sel.value);if(!current||!kinds.includes(current.kind)){const next=SLOTS.find(s=>kinds.includes(s.kind));if(next)sel.value=next.id;}
}
function renderSalaryResults(){
 const q=(document.getElementById('salarySearch').value||'').trim().toLocaleLowerCase('ru');
 const club=document.getElementById('salaryClubFilter').value;
 const match=document.getElementById('salaryMatchFilter').value;
 const arr=CONTRACT_DB.filter(r=>(!q||(r.name+' '+r.club+' '+r.clubEn+' '+r.profileName).toLocaleLowerCase('ru').includes(q))&&(club==='all'||r.club===club)&&(match==='all'||(match==='matched'?!!r.globalId:!r.globalId)));
 document.getElementById('salaryCount').textContent=`Найдено ${arr.length} записей · показываю первые ${Math.min(30,arr.length)}. Отдельно не привязано автоматически: ${CONTRACT_DB.filter(r=>!r.globalId).length}`;
 const root=document.getElementById('salaryResults');
 root.innerHTML=arr.slice(0,30).map(r=>`<button type="button" class="scout-result" data-salary-rank="${r.rank}"><strong>${esc(r.name)} · ${esc(String(r.salaryMln))} млн ₽</strong><div class="scout-meta">${esc(r.club)} · ${esc(String(r.age||'возраст н/д'))} лет · ${esc(r.position||'позиция н/д')} · сезон ${esc(r.season)}</div><div class="scout-meta">${r.globalId?`Кандидат в общей базе: ${esc(r.profileName)}${r.profileDob?' · ДР '+esc(r.profileDob):''} · привязка предварительная, ДР отсутствует в зарплатном источнике`: 'Не присоединён к профилю автоматически — проверь ФИО/команду/возраст'}</div></button>`).join('')||'<div class="scout-empty">Записей по этому фильтру не найдено.</div>';
 root.querySelectorAll('[data-salary-rank]').forEach(el=>el.addEventListener('click',()=>{const r=CONTRACT_DB.find(x=>x.rank===Number(el.dataset.salaryRank));if(!r)return;if(!r.globalId){showToast('Профиль не определён однозначно — запись оставлена отдельно.');return;}selectedScoutId=r.globalId;document.getElementById('scoutSearch').value=r.profileName||r.name;document.getElementById('scoutLeague').value='all';document.getElementById('scoutType').value='all';renderScoutResults();updateScoutSelection();document.getElementById('scoutPanel').scrollIntoView({behavior:'smooth',block:'start'});}));
}
function initSalaryPanel(){const sel=document.getElementById('salaryClubFilter');const clubs=[...new Set(CONTRACT_DB.map(r=>r.club).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'ru'));for(const club of clubs){const o=document.createElement('option');o.value=club;o.textContent=club;sel.appendChild(o);}document.getElementById('salarySearch').addEventListener('input',renderSalaryResults);document.getElementById('salaryClubFilter').addEventListener('change',renderSalaryResults);document.getElementById('salaryMatchFilter').addEventListener('change',renderSalaryResults);renderSalaryResults();}
function initScoutTarget(){const sel=document.getElementById('scoutTarget');sel.innerHTML=SLOTS.map(s=>`<option value="${esc(s.id)}">${esc(s.name)} — ${esc(s.section==='forward'?s.line+'-е звено':s.section==='defense'?s.pair+'-я пара':'вратари')}</option>`).join('');}
document.getElementById('scoutSearch').addEventListener('input',renderScoutResults);
document.getElementById('scoutLeague').addEventListener('change',renderScoutResults);
document.getElementById('scoutType').addEventListener('change',renderScoutResults);
document.getElementById('scoutInsert').addEventListener('click',()=>{
 const p=SCOUT_DB.find(x=>x.id===selectedScoutId);if(!p)return;
 const slot=SLOTS.find(s=>s.id===document.getElementById('scoutTarget').value);if(!slot)return;
 const kinds=scoutPlayerKinds(p);if(!kinds.includes(slot.kind)){showToast('Амплуа игрока не соответствует выбранной позиции');return;}
 const displayName=`${p.name}${p.dob?' · '+p.dob:''}`;
 if(Object.entries(state).some(([id,v])=>id!==slot.id&&v.player===displayName)){showToast('Этот профиль уже выбран в составе');return;}
 let obj=playerByName.get(displayName);
 if(!obj){obj={name:displayName,fullName:p.name,dob:p.dob,globalId:p.id,teams:p.teams||[],gamesByTeam:[],matches:p.games||0,bestRoles:[],reportedFits:[],roleChecks:{},positions:kinds,positionsLabel:kinds.join(' / '),teamLabel:(p.teams||[]).join(' / '),gamesLabel:String(p.games||'н/д'),databaseProfile:true,leagues:p.leagues||[],seasons:p.seasons||[],stats:p.stats||{},recentLeague:p.recentLeague,recentSeason:p.recentSeason,reportedSalary2026_27Mln:p.reportedSalary2026_27Mln,salarySourceTeam:p.salarySourceTeam,salaryMatchStatus:p.salaryMatchStatus,salarySourceUrl:p.salarySourceUrl,salarySourceAsOf:p.salarySourceAsOf};DATA.players.push(obj);playerByName.set(displayName,obj);}
 state[slot.id].player=displayName;renderCards();renderRink();document.getElementById(`card-${slot.id}`).scrollIntoView({behavior:'smooth',block:'center'});showToast(`Добавлен: ${displayName}`);
});
