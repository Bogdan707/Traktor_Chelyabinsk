    const role=roleByNo(roleNo); const keys=(role?.criteria||[]).map(metricSpec).filter(Boolean);
    let up=0,down=0,flat=0,matched=0;
    for(const spec of keys){
      const d=row.d[spec.key];
      if(d==null) continue;
      matched++;
      const threshold=isPercentMetric(spec.key)?1.0:(spec.key==='Short-handed time'?5:0.03);
      const isPositive=spec.higher ? d>threshold : d< -threshold;
      const isNegative=spec.higher ? d< -threshold : d>threshold;
      if(isPositive)up++; else if(isNegative)down++; else flat++;
    }
    if(!matched) return 'Нет двухсезонного тренда по метрикам этой роли.';
    return `Сезонный тренд 2024/25 → 2025/26 по доступным показателям роли: ${up} улучшились, ${down} ухудшились, ${flat} без заметного изменения. Не экстраполировать как гарантированный темп.`;
