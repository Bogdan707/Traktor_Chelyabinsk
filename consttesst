    for(const p of DATA.players){
      const db=p.globalId?SCOUT_DB.find(x=>x.id===p.globalId):null;
      rows.push({key:playerKey(p),name:p.fullName||p.name,dob:p.dob||db?.dob||'',league:db?(db.leagues||[]).join('/'): 'Системная модель',teams:p.teams||[],source:db?'Общая база + системный список':'Исходный системный список',system:true,position:effectivePositionCode(p),obj:p});
    }
    for(const p of SCOUT_DB){
      const key=playerKey(p);
      if(sysKeys.has(key)) continue;
      rows.push({key,name:p.name,dob:p.dob||'',league:(p.leagues||[]).join('/'),teams:p.teams||[],source:'Общая скаутская база',system:false,position:effectivePositionCode(p),obj:p});
    }
    return rows;
  }
  function toggleExclude(key){
    const exists=excludedSystemKeys.has(key);
    if(exists) excludedSystemKeys.delete(key); else excludedSystemKeys.add(key);
    if(!exists){
      for(const s of SLOTS){
        const p=playerByName.get(state[s.id].player);
        if(p && playerKey(p)===key) state[s.id].player='';
      }
    }
    persistSettings();renderManualRows();renderCards();renderRink();renderScoutResults();updateCounter();
  }
  function renderManualRows(){
    const searchEl=document.getElementById('manualSearch');if(!searchEl)return;
    const q=norm(searchEl.value), scope=document.getElementById('manualScope').value;
    const all=getAdminItems();
    let arr=all.filter(x=>{
      if(scope==='system'&&!x.system) return false;
      if(scope==='database'&&x.source==='Исходный системный список') return false;
      if(q) return norm([x.name,x.dob,x.league,(x.teams||[]).join(' '),x.source].join(' ')).includes(q);
      if(scope==='database') return x.source!=='Исходный системный список';
      return x.system;
    });
    const total=arr.length;
    if(!q && scope==='all') arr=arr.slice(0,80);
    else arr=arr.slice(0,80);
    document.getElementById('manualStats').textContent=`Показано ${arr.length} из ${total.toLocaleString('ru-RU')} совпадений. Убрано из системного списка: ${excludedSystemKeys.size}; ручных позиций: ${Object.keys(positionOverrides).length}.`;
    document.getElementById('manualRows').innerHTML=arr.length?arr.map(x=>{
      const currentOverride=positionOverrides[x.key];
      const select=`<select data-admin-position="${esc(x.key)}"><option value="__source__" ${!currentOverride?'selected':''}>Источник: ${esc(x.position?POSITION_LABELS[x.position]||x.position:'не указано')}</option>${POSITION_OPTIONS.map(([c,l])=>`<option value="${c}" ${currentOverride===c?'selected':''}>${esc(l)}${currentOverride===c?' · вручную':''}</option>`).join('')}</select>`;
      const isOut=excludedSystemKeys.has(x.key);
      const control=x.system||isOut?`<button type="button" class="btn ${isOut?'restore':'remove'}" data-exclude-key="${esc(x.key)}">${isOut?'Вернуть в список':'Убрать из системы'}</button>`:`<button type="button" class="btn" disabled>Не в системном списке</button>`;
      return `<div class="manual-row"><div class="manual-details"><strong>${esc(x.name)}${x.dob?' · '+esc(x.dob):''}</strong><small>${esc(x.source)} · ${esc(x.league||'лига н/д')} · ${esc((x.teams||[]).slice(0,5).join(', ')||'команда н/д')}<br>Позиция: ${esc(positionLabel(x.obj))}</small></div>${select}${control}</div>`;
    }).join(''):'<div class="manual-empty">Нет совпадений. Введи не менее двух символов для поиска по общей базе.</div>';
    document.querySelectorAll('[data-admin-position]').forEach(el=>el.addEventListener('change',()=>{
      const key=el.dataset.adminPosition;
      if(el.value==='__source__') delete positionOverrides[key]; else positionOverrides[key]=el.value;
      persistSettings();renderManualRows();renderCards();updateRink();renderScoutResults();
      showToast('Позиция сохранена');
    }));
    document.querySelectorAll('[data-exclude-key]').forEach(el=>el.addEventListener('click',()=>toggleExclude(el.dataset.excludeKey)));
  }
  function saveSettingsFile(){
    const payload={version:1,positionOverrides,excludedSystemKeys:[...excludedSystemKeys],forecastHorizon,exportedAt:new Date().toISOString()};
    const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json;charset=utf-8'});
    const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='traktor_manual_player_settings.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
  }
  function loadSettingsObject(obj){
    if(!obj || typeof obj!=='object') throw new Error('Некорректный JSON настроек');
    positionOverrides=obj.positionOverrides && typeof obj.positionOverrides==='object' ? obj.positionOverrides : {};
    excludedSystemKeys=new Set(Array.isArray(obj.excludedSystemKeys)?obj.excludedSystemKeys:[]);
    forecastHorizon=[2,3,4].includes(Number(obj.forecastHorizon))?Number(obj.forecastHorizon):3;
    persistSettings();
    const horizonSel=document.getElementById('forecastHorizon');if(horizonSel)horizonSel.value=String(forecastHorizon);
    for(const s of SLOTS){const p=playerByName.get(state[s.id].player);if(p&&isExcluded(p))state[s.id].player='';}
    renderManualRows();renderCards();renderRink();renderScoutResults();updateCounter();renderBenchmarkPanel();
  }
  function initializeManualPanel(){
    const h=document.getElementById('forecastHorizon');if(h){h.value=String(forecastHorizon);h.addEventListener('change',()=>{forecastHorizon=[2,3,4].includes(Number(h.value))?Number(h.value):3;persistSettings();renderCards();updateRink();renderScoutResults();});}
    document.getElementById('manualSearch').addEventListener('input',renderManualRows);
    // Existing markup had handlers bound to the pre-upgrade renderer; bind the enhanced renderer too.
    document.getElementById('scoutSearch').addEventListener('input',renderScoutResults);
    document.getElementById('scoutLeague').addEventListener('change',renderScoutResults);
    document.getElementById('scoutType').addEventListener('change',renderScoutResults);
    document.getElementById('scoutTarget').addEventListener('change',renderScoutResults);
    document.getElementById('manualScope').addEventListener('change',renderManualRows);
    document.getElementById('exportManualSettings').addEventListener('click',saveSettingsFile);
    document.getElementById('importManualSettings').addEventListener('click',()=>document.getElementById('manualFileInput').click());
    document.getElementById('manualFileInput').addEventListener('change',ev=>{
      const file=ev.target.files?.[0];if(!file)return;
      const reader=new FileReader();reader.onload=()=>{try{loadSettingsObject(JSON.parse(String(reader.result||'{}')));showToast('Настройки импортированы');}catch(e){showToast('Не удалось импортировать JSON настроек');}};
      reader.readAsText(file);ev.target.value='';
    });
    document.getElementById('benchmarkSeason').addEventListener('change',renderBenchmarkPanel);
    document.querySelectorAll('[data-position-edit]').forEach(el=>el.addEventListener('change',()=>{}));
  }
  // When excluding a legacy source, clear any default slot selections now hidden from the picker.
  for(const s of SLOTS){
    const p=playerByName.get(state[s.id].player);
    if(p && isExcluded(p)) state[s.id].player='';
  }
  initializeManualPanel();
  renderBenchmarkPanel();
  renderManualRows();
  // Re-render all interactive views using the new scoring/position logic.
  initScoutTarget();
  renderScoutResults();
  updateScoutSelection();
  renderCards();
  renderRink();
  updateCounter();
  return {computeFit,renderBenchmarkPanel,renderManualRows,positionLabel};
})();
</script></body></html>
